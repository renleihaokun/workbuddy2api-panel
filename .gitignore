# Auth & secrets
auths/
data/
*.key
*.pem
*.env
.env
.env.*

# Binaries (anchored to repo root only — bare "login"/"credit" would also ignore cmd/login/, cmd/credit/)
/login
/credit
/wb2api
/signin_bin

# Config with secrets (use config.example.json)
config.json

# Build artifacts
*.tmp
__pycache__/

# Backups (contains auth tokens)
backups/

# IDE
.idea/
.vscode/
LOOP.md
PLAN.md
SPEC.md

# 设计/计划文档：只跟踪 README.md、AGENTS.md 与 docs/ 下的公开规范 / 研究归档。
# 必须用 root 锚定匹配；裸 `*.md` 会让 Git 不进入 docs/ 目录，后面的反选也无效。
/*.md
!/README.md
!/AGENTS.md
!/docs/**/*.md

# Windows binaries
/wb2api.exe
/login.exe
/credit.exe

# 本地验证工具（判据逆向过程脚本，结论沉淀于 data/desktop-task-protocol.md）
/cmd/desktopverify*/
*.zip
server.exe
.DS_Store

# Deployment runtime artifacts
deploy-*.log
deploy-last-status
